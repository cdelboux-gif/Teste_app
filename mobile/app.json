{
  "expo": {
    "name": "VitaPoint",
    "slug": "vitapoint",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "vitapoint",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router", "expo-secure-store"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vitapoint.health"
    },
    "android": {
      "package": "com.vitapoint.health",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
